<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IvkExportTool.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="IvkExportTool.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="IvkExportTool - MySQL Database Exporter"
        Width="1200" Height="800"
        MinWidth="600" MinHeight="400"
        Background="{DynamicResource SurfaceBrush}">

  <Design.DataContext>
    <vm:MainWindowViewModel/>
  </Design.DataContext>

  <Grid>
    <Grid.RowDefinitions>
      <!-- ConnectionStatusBar - компактная панель состояния (отображается только при подключении) -->
      <RowDefinition Height="Auto"/>
      <!-- Главная область с таблицами -->
      <RowDefinition Height="*"/>
      <!-- StatusBar - нижняя панель с кнопкой экспорта -->
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ========== 1. CONNECTION STATUS BAR ========== -->
    <!-- Компактная панель состояния подключения (40px) -->
    <Border Grid.Row="0"
            Classes="connection-status-bar"
            IsVisible="{Binding IsConnected}">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">

        <!-- Индикатор + текст соединения -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <Ellipse Width="10" Height="10"
                   Fill="{Binding ConnectionStatusColor}"
                   VerticalAlignment="Center"/>
          <TextBlock Text="{Binding ConnectionString}"
                     Foreground="White"
                     FontSize="13"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Разделитель -->
        <Border Grid.Column="1" Width="1"
                Background="#40FFFFFF"
                Margin="12,8"/>

        <!-- Выбор базы данных -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="4,0">
          <TextBlock Text="БД:"
                     Foreground="White"
                     FontSize="13"
                     VerticalAlignment="Center"/>
          <ComboBox ItemsSource="{Binding Databases}"
                    SelectedItem="{Binding SelectedDatabase}"
                    MinWidth="200" MaxWidth="350"
                    Height="28"
                    VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Кнопки управления -->
        <Button Grid.Column="3"
                ToolTip.Tip="Обновить список БД"
                Command="{Binding RefreshDatabasesCommand}"
                Classes="icon-button-status">
          <PathIcon Data="{StaticResource RefreshIcon}"
                    Width="16" Height="16"/>
        </Button>

        <Button Grid.Column="4"
                ToolTip.Tip="Настройки подключения"
                Classes="icon-button-status"
                Margin="4,0,0,0">
          <PathIcon Data="{StaticResource SettingsIcon}"
                    Width="16" Height="16"/>
        </Button>

        <Button Grid.Column="5"
                ToolTip.Tip="Отключиться"
                Command="{Binding DisconnectCommand}"
                Classes="icon-button-status"
                Margin="4,0,8,0">
          <PathIcon Data="{StaticResource DisconnectIcon}"
                    Width="16" Height="16"/>
        </Button>
      </Grid>
    </Border>

    <!-- ========== 2. MAIN CONTENT AREA ========== -->
    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <!-- ToolBar с поиском и фильтрами -->
        <RowDefinition Height="Auto"/>
        <!-- DataGrid со списком таблиц -->
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Форма подключения (отображается только когда НЕ подключены) -->
      <Border Grid.Row="0" Grid.RowSpan="2"
              IsVisible="{Binding !IsConnected}"
              Background="{DynamicResource SurfaceBrush}"
              Padding="48">
        <Border Classes="card"
                MaxWidth="600"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="20">
            <!-- Заголовок -->
            <TextBlock Text="Подключение к MySQL"
                       Classes="h3"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <!-- Параметры подключения -->
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto">

              <!-- Host -->
              <TextBlock Grid.Row="0" Grid.Column="0"
                         Text="Хост:"
                         Classes="label"
                         VerticalAlignment="Center"
                         Margin="0,0,12,12"/>
              <TextBox Grid.Row="0" Grid.Column="1"
                       Text="{Binding Host}"
                       Watermark="localhost или IP адрес"
                       Margin="0,0,0,12"/>

              <!-- Port -->
              <TextBlock Grid.Row="1" Grid.Column="0"
                         Text="Порт:"
                         Classes="label"
                         VerticalAlignment="Center"
                         Margin="0,0,12,12"/>
              <TextBox Grid.Row="1" Grid.Column="1"
                       Text="{Binding Port}"
                       Watermark="3306"
                       Margin="0,0,0,12"/>

              <!-- Username -->
              <TextBlock Grid.Row="2" Grid.Column="0"
                         Text="Логин:"
                         Classes="label"
                         VerticalAlignment="Center"
                         Margin="0,0,12,12"/>
              <TextBox Grid.Row="2" Grid.Column="1"
                       Text="{Binding Username}"
                       Watermark="root"
                       Margin="0,0,0,12"/>

              <!-- Password -->
              <TextBlock Grid.Row="3" Grid.Column="0"
                         Text="Пароль:"
                         Classes="label"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0"/>
              <TextBox Grid.Row="3" Grid.Column="1"
                       Text="{Binding Password}"
                       PasswordChar="●"
                       Watermark="password"/>
            </Grid>

            <!-- Статус -->
            <TextBlock Text="{Binding StatusMessage}"
                       Classes="body"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"/>

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="12">
              <Button Content="Тест подключения"
                      Classes="secondary"
                      Command="{Binding TestConnectionCommand}"
                      IsEnabled="{Binding !IsLoading}"
                      Width="150"/>
              <Button Content="Подключиться"
                      Classes="primary"
                      Command="{Binding ConnectCommand}"
                      IsEnabled="{Binding !IsLoading}"
                      Width="150"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>

      <!-- ToolBar (отображается только когда подключены) -->
      <Border Grid.Row="0"
              Classes="toolbar"
              IsVisible="{Binding IsConnected}">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">

          <!-- Поиск -->
          <TextBox Grid.Column="0"
                   Watermark="🔍 Поиск таблиц..."
                   Text="{Binding SearchText}"
                   Classes="search-box"
                   Margin="0,0,8,0"/>

          <!-- Кнопки -->
          <Button Grid.Column="1"
                  Content="✓ Все"
                  Command="{Binding SelectAllTablesCommand}"
                  Classes="toolbar-button"
                  Margin="0,0,8,0"/>

          <Button Grid.Column="2"
                  Content="✗ Сброс"
                  Command="{Binding DeselectAllTablesCommand}"
                  Classes="toolbar-button"
                  Margin="0,0,8,0"/>

          <DropDownButton Grid.Column="3"
                          Content="🎯 Фильтр"
                          Classes="toolbar-button">
            <DropDownButton.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="По размеру">
                  <MenuItem Header="> 1 MB"
                            Command="{Binding FilterBySizeCommand}"
                            CommandParameter="1"/>
                  <MenuItem Header="> 10 MB"
                            Command="{Binding FilterBySizeCommand}"
                            CommandParameter="10"/>
                  <MenuItem Header="> 100 MB"
                            Command="{Binding FilterBySizeCommand}"
                            CommandParameter="100"/>
                </MenuItem>
                <MenuItem Header="По строкам">
                  <MenuItem Header="> 1,000"
                            Command="{Binding FilterByRowsCommand}"
                            CommandParameter="1000"/>
                  <MenuItem Header="> 10,000"
                            Command="{Binding FilterByRowsCommand}"
                            CommandParameter="10000"/>
                  <MenuItem Header="> 100,000"
                            Command="{Binding FilterByRowsCommand}"
                            CommandParameter="100000"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Показать только пустые"
                          Command="{Binding ShowEmptyTablesCommand}"/>
                <MenuItem Header="Сбросить фильтры"
                          Command="{Binding ClearFiltersCommand}"/>
              </MenuFlyout>
            </DropDownButton.Flyout>
          </DropDownButton>
        </Grid>
      </Border>

      <!-- DataGrid со списком таблиц -->
      <DataGrid Grid.Row="1"
                ItemsSource="{Binding FilteredTables}"
                IsVisible="{Binding IsConnected}"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                GridLinesVisibility="Horizontal"
                SelectionMode="Extended"
                IsReadOnly="True"
                Classes="tables-grid"
                AutoGenerateColumns="False">

        <DataGrid.Columns>
          <!-- Чекбокс для выбора -->
          <DataGridTemplateColumn Width="50" CanUserResize="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Иконка типа таблицы -->
          <DataGridTemplateColumn Width="40" CanUserResize="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <PathIcon Data="{DynamicResource GenericTableIcon}"
                          Width="16" Height="16"
                          Foreground="{StaticResource SecondaryBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Название таблицы -->
          <DataGridTextColumn Header="Таблица"
                              Binding="{Binding Name}"
                              Width="*"
                              MinWidth="150"
                              FontFamily="Consolas"
                              FontSize="13"/>

          <!-- Количество строк -->
          <DataGridTextColumn Header="Строки"
                              Binding="{Binding RowCount, StringFormat='{}{0:N0}'}"
                              Width="120"
                              FontFamily="Consolas"
                              FontSize="13"/>

          <!-- Размер -->
          <DataGridTextColumn Header="Размер"
                              Binding="{Binding SizeFormatted}"
                              Width="100"
                              FontFamily="Consolas"
                              FontSize="13"/>

          <!-- Engine -->
          <DataGridTextColumn Header="Engine"
                              Binding="{Binding Engine}"
                              Width="80"
                              FontSize="13"/>

          <!-- Последнее обновление -->
          <DataGridTextColumn Header="Обновлено"
                              Binding="{Binding LastUpdateFormatted}"
                              Width="150"
                              FontSize="13"/>
        </DataGrid.Columns>
      </DataGrid>

    </Grid>

    <!-- ========== 3. STATUS BAR ========== -->
    <!-- Нижняя панель со статистикой и кнопкой экспорта -->
    <Border Grid.Row="2" Classes="status-bar">
      <Grid ColumnDefinitions="*,Auto">

        <!-- Статистика -->
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="16"
                    IsVisible="{Binding IsConnected}">

          <!-- Выбрано таблиц -->
          <TextBlock Classes="status-text">
            <Run Text="✓ Выбрано:"/>
            <Run Text="{Binding SelectedCount}"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource PrimaryBrush}"/>
            <Run Text="таблиц"/>
          </TextBlock>

          <TextBlock Text="•"
                     Foreground="{StaticResource BorderBrush}"
                     VerticalAlignment="Center"/>

          <!-- Общее количество строк -->
          <TextBlock Classes="status-text">
            <Run Text="{Binding TotalRows, StringFormat='{}{0:N0}'}"/>
            <Run Text="строк"/>
          </TextBlock>

          <TextBlock Text="•"
                     Foreground="{StaticResource BorderBrush}"
                     VerticalAlignment="Center"/>

          <!-- Общий размер -->
          <TextBlock Classes="status-text">
            <Run Text="{Binding TotalSize}"/>
          </TextBlock>

          <!-- Индикатор активных фильтров -->
          <Border Classes="filter-badge"
                  IsVisible="{Binding HasActiveFilters}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <PathIcon Data="{StaticResource FilterIcon}"
                        Width="12" Height="12"
                        Foreground="White"/>
              <TextBlock Text="{Binding ActiveFiltersCount}"
                         Foreground="White"
                         FontSize="11"
                         FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Статус когда не подключены -->
        <TextBlock Grid.Column="0"
                   Text="{Binding StatusMessage}"
                   Classes="status-text"
                   IsVisible="{Binding !IsConnected}"/>

        <!-- Кнопка экспорта -->
        <Button Grid.Column="1"
                Classes="accent export-button"
                Command="{Binding ExportCommand}"
                IsEnabled="{Binding HasSelectedTables}"
                IsVisible="{Binding IsConnected}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource SaveIcon}"
                      Width="16" Height="16"
                      Foreground="White"/>
            <TextBlock Text="Экспортировать SQL"
                       FontWeight="SemiBold"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

  </Grid>
</Window>
