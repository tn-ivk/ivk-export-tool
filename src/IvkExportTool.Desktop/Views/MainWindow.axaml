<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IvkExportTool.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="IvkExportTool.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Transneft.ico"
        Title="IvkExportTool - Подключение к БД ИВК"
        Width="1200" Height="800"
        MinWidth="600" MinHeight="400"
        Background="{DynamicResource SurfaceBrush}">

  <Design.DataContext>
    <vm:MainWindowViewModel/>
  </Design.DataContext>

  <Grid>
    <Grid.RowDefinitions>
      <!-- ConnectionStatusBar - компактная панель состояния -->
      <RowDefinition Height="Auto"/>
      <!-- Главная область с таблицами -->
      <RowDefinition Height="*"/>
      <!-- StatusBar - нижняя панель с кнопкой экспорта -->
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Overlay для индикатора загрузки -->
    <Border Grid.Row="0" Grid.RowSpan="3"
            Background="#80000000"
            IsVisible="{Binding IsLoading}"
            ZIndex="999">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="16">
        <ProgressBar IsIndeterminate="True"
                     Width="200"
                     Height="4"
                     Foreground="{StaticResource PrimaryBrush}"/>
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="White"
                   FontSize="14"
                   FontWeight="Medium"
                   HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- ========== 1. CONNECTION STATUS BAR ========== -->
    <!-- Компактная панель состояния подключения (40px) -->
    <Border Grid.Row="0"
            Classes="connection-status-bar">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">

        <!-- Индикатор + текст соединения -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <Ellipse Width="10" Height="10"
                   Fill="{Binding ConnectionStatusColor}"
                   VerticalAlignment="Center"/>
          <TextBlock Text="{Binding ConnectionString}"
                     Foreground="White"
                     FontSize="13"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Разделитель -->
        <Border Grid.Column="1" Width="1"
                Background="#40FFFFFF"
                Margin="12,8"/>

        <!-- Выбор базы данных -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="4,0">
          <TextBlock Text="БД:"
                     Foreground="White"
                     FontSize="13"
                     VerticalAlignment="Center"/>
          <ComboBox ItemsSource="{Binding Databases}"
                    SelectedItem="{Binding SelectedDatabase}"
                    MinWidth="200" MaxWidth="350"
                    Height="28"
                    VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Кнопки управления -->
        <Button Grid.Column="3"
                ToolTip.Tip="Обновить список БД"
                Command="{Binding RefreshDatabasesCommand}"
                Classes="icon-button-status">
          <PathIcon Data="{StaticResource RefreshIcon}"
                    Width="16" Height="16"/>
        </Button>

        <Button Grid.Column="4"
                ToolTip.Tip="Отключиться"
                Command="{Binding ChangeConnectionCommand}"
                Classes="icon-button-status"
                Margin="4,0,8,0">
          <PathIcon Data="{StaticResource CloseIcon}"
                    Width="14" Height="14"/>
        </Button>
      </Grid>
    </Border>

    <!-- ========== 2. MAIN CONTENT AREA ========== -->
    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <!-- ToolBar с поиском и фильтрами -->
        <RowDefinition Height="Auto"/>
        <!-- DataGrid со списком таблиц -->
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ToolBar -->
      <Border Grid.Row="0"
              Classes="toolbar">
        <Grid ColumnDefinitions="*">

          <!-- Поиск -->
          <TextBox Grid.Column="0"
                   Watermark="🔍 Поиск таблиц..."
                   Text="{Binding SearchText}"
                   Classes="search-box"/>

        </Grid>
      </Border>

      <!-- DataGrid со списком таблиц -->
      <DataGrid Grid.Row="1"
                x:Name="TablesGrid"
                ItemsSource="{Binding FilteredTables}"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                ColumnHeaderHeight="40"
                SelectionMode="Extended"
                IsReadOnly="True"
                Classes="tables-grid"
                AutoGenerateColumns="False">

        <DataGrid.Styles>
          <Style Selector="DataGridColumnHeader">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
          </Style>
          <Style Selector="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
          </Style>
        </DataGrid.Styles>

        <DataGrid.Columns>
          <!-- Чекбокс для выбора -->
          <DataGridTemplateColumn Width="50" CanUserResize="False">
            <DataGridTemplateColumn.Header>
              <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <CheckBox IsThreeState="True"
                          Width="20" Height="20"
                          VerticalAlignment="Center"
                          IsChecked="{Binding DataContext.TablesSelectionState, ElementName=TablesGrid, Mode=OneWay}"
                          Command="{Binding DataContext.ToggleAllTablesSelectionCommand, ElementName=TablesGrid}"
                          ToolTip.Tip="Выбрать / Снять выбор со всех таблиц"/>
              </Border>
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Название таблицы -->
          <DataGridTextColumn Header="Таблица"
                              Binding="{Binding Name}"
                              Width="*"
                              MinWidth="150"
                              FontFamily="Consolas"
                              FontSize="13"/>

          <!-- Размер -->
          <DataGridTemplateColumn Header="Размер"
                                  SortMemberPath="SizeInBytes"
                                  Width="140"
                                  MinWidth="120">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding SizeFormatted}"
                          FontFamily="Consolas"
                          FontSize="13"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

    </Grid>

    <!-- ========== 3. STATUS BAR ========== -->
    <!-- Нижняя панель со статистикой и кнопкой экспорта -->
    <Border Grid.Row="2" Classes="status-bar">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Детальный прогресс экспорта (показывается только во время экспорта) -->
        <Border Grid.Row="0"
                IsVisible="{Binding IsExporting}"
                Background="{StaticResource SurfaceContainerHighBrush}"
                Padding="16,8"
                CornerRadius="8 8 0 0">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
              <!-- Детальное сообщение о статусе -->
              <TextBlock Text="{Binding DetailedStatusMessage}"
                         FontSize="12"
                         Foreground="{StaticResource OnSurfaceVariantBrush}"
                         TextTrimming="CharacterEllipsis"/>

              <!-- Progress Bar -->
              <ProgressBar Value="{Binding ExportProgress}"
                           Minimum="0" Maximum="100"
                           Height="6"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource PrimaryBrush}"/>
            </StackPanel>

            <!-- Прошедшее время -->
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       FontSize="13"
                       FontWeight="SemiBold"
                       FontFamily="Consolas"
                       Foreground="{StaticResource PrimaryBrush}">
              <Run Text="Время"/>
              <Run Text="{Binding ElapsedTime}"/>
            </TextBlock>
          </Grid>
        </Border>

        <!-- Основная строка статуса -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="16,8">

          <!-- Сообщение о статусе -->
          <TextBlock Grid.Column="0"
                     Text="{Binding StatusMessage}"
                     Foreground="{StaticResource OnSurfaceVariantBrush}"
                     FontSize="13"
                     VerticalAlignment="Center"
                     Margin="0,0,16,0"
                     TextTrimming="CharacterEllipsis"
                     MaxWidth="300"/>

          <!-- Статистика -->
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="16"
                      IsVisible="{Binding !IsExporting}">

            <!-- Выбрано таблиц -->
            <TextBlock Classes="status-text">
              <Run Text="✓ Выбрано:"/>
              <Run Text="{Binding SelectedCount}"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryBrush}"/>
              <Run Text="таблиц"/>
            </TextBlock>

            <TextBlock Text="•"
                       Foreground="{StaticResource BorderBrush}"
                       VerticalAlignment="Center"/>

            <!-- Общее количество строк -->
            <TextBlock Classes="status-text">
              <Run Text="{Binding TotalRows, StringFormat='{}{0:N0}'}"/>
              <Run Text="строк"/>
            </TextBlock>

            <TextBlock Text="•"
                       Foreground="{StaticResource BorderBrush}"
                       VerticalAlignment="Center"/>

            <!-- Общий размер -->
            <TextBlock Classes="status-text">
              <Run Text="{Binding TotalSize}"/>
            </TextBlock>
          </StackPanel>

          <!-- Кнопка экспорта -->
          <Button Grid.Column="2"
                  Classes="accent export-button"
                  Command="{Binding ExportCommand}"
                  IsEnabled="{Binding HasSelectedTables}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource SaveIcon}"
                        Width="16" Height="16"
                        Foreground="White"/>
              <TextBlock Text="Экспортировать SQL"
                         FontWeight="SemiBold"/>
            </StackPanel>
          </Button>
        </Grid>
      </Grid>
    </Border>

  </Grid>
</Window>
