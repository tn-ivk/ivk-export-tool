<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IvkExportTool.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="IvkExportTool.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="IVK Export Tool - MySQL Database Exporter"
        Width="900" Height="700"
        MinWidth="800" MinHeight="600"
        Background="{DynamicResource SurfaceBrush}">

  <Design.DataContext>
    <vm:MainWindowViewModel/>
  </Design.DataContext>

  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Заголовок -->
    <TextBlock Grid.Row="0"
               Text="MySQL Database Exporter"
               Classes="h2"
               Margin="0,0,0,24"/>

    <!-- Параметры подключения -->
    <Border Grid.Row="1" Classes="card" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="Параметры подключения"
                   Classes="h4"
                   Margin="0,0,0,16"/>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Host -->
          <TextBlock Grid.Row="0" Grid.Column="0"
                     Text="Host:"
                     Classes="label"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0"/>
          <TextBox Grid.Row="0" Grid.Column="1"
                   Text="{Binding Host}"
                   Watermark="localhost"
                   Margin="0,0,24,12"/>

          <!-- Port -->
          <TextBlock Grid.Row="0" Grid.Column="2"
                     Text="Port:"
                     Classes="label"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0"/>
          <TextBox Grid.Row="0" Grid.Column="3"
                   Text="{Binding Port}"
                   Watermark="3306"
                   Width="120"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,12"/>

          <!-- Username -->
          <TextBlock Grid.Row="1" Grid.Column="0"
                     Text="Username:"
                     Classes="label"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0"/>
          <TextBox Grid.Row="1" Grid.Column="1"
                   Text="{Binding Username}"
                   Watermark="root"
                   Margin="0,0,24,12"/>

          <!-- Password -->
          <TextBlock Grid.Row="1" Grid.Column="2"
                     Text="Password:"
                     Classes="label"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0"/>
          <TextBox Grid.Row="1" Grid.Column="3"
                   Text="{Binding Password}"
                   PasswordChar="*"
                   Watermark="password"
                   Margin="0,0,0,12"/>

          <!-- Кнопки -->
          <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Margin="0,16,0,0">
            <Button Content="Тест подключения"
                    Classes="secondary"
                    Command="{Binding TestConnectionCommand}"
                    IsEnabled="{Binding !IsLoading}"
                    Margin="0,0,12,0"/>
            <Button Content="Подключиться"
                    Classes="primary"
                    Command="{Binding ConnectCommand}"
                    IsEnabled="{Binding !IsLoading}"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- База данных и таблицы -->
    <Border Grid.Row="2" Classes="card" Margin="0,0,0,16" IsEnabled="{Binding IsConnected}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Выбор базы данных -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
          <TextBlock Text="База данных:"
                     Classes="label"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0"/>
          <ComboBox ItemsSource="{Binding Databases}"
                    SelectedItem="{Binding SelectedDatabase}"
                    MinWidth="220"
                    Margin="0,0,12,0"/>
          <Button Content="Обновить таблицы"
                  Classes="outlined"
                  Command="{Binding RefreshTablesCommand}"/>
        </StackPanel>

        <!-- Список таблиц -->
        <Border Grid.Row="1"
                Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="1"
                CornerRadius="6">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Tables}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource BorderLightBrush}"
                          BorderThickness="0,0,0,1"
                          Padding="16,12">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <CheckBox Grid.Column="0"
                                IsChecked="{Binding IsSelected}"
                                Margin="0,0,16,0"/>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Name}"
                                 Classes="body"
                                 FontWeight="Medium"
                                 VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2"
                                 Text="{Binding RowCount, StringFormat='Rows: {0}'}"
                                 Classes="caption"
                                 VerticalAlignment="Center"
                                 Margin="16,0"/>
                      <TextBlock Grid.Column="3"
                                 Text="{Binding Engine}"
                                 Classes="caption"
                                 VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <!-- Кнопки управления таблицами -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
          <Button Content="Выбрать все"
                  Classes="secondary"
                  Command="{Binding SelectAllTablesCommand}"
                  Margin="0,0,12,0"/>
          <Button Content="Снять выбор"
                  Classes="outlined"
                  Command="{Binding DeselectAllTablesCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Прогресс экспорта -->
    <Border Grid.Row="3"
            Classes="panel"
            Margin="0,0,0,16"
            IsVisible="{Binding IsExporting}">
      <StackPanel>
        <TextBlock Text="Экспорт данных..."
                   Classes="body"
                   FontWeight="Medium"
                   Margin="0,0,0,8"/>
        <ProgressBar Value="{Binding ExportProgress}"
                     Minimum="0"
                     Maximum="100"
                     Height="8"/>
        <TextBlock Text="{Binding ExportProgress, StringFormat='Прогресс: {0}%'}"
                   Classes="caption"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0"/>
      </StackPanel>
    </Border>

    <!-- Статус и кнопка экспорта -->
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Text="{Binding StatusMessage}"
                 Classes="body"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"/>
      <Button Grid.Column="1"
              Content="Экспортировать"
              Classes="primary"
              Command="{Binding ExportCommand}"
              IsEnabled="{Binding !IsExporting}"
              Padding="32,12"
              FontWeight="Medium"
              FontSize="16"/>
    </Grid>

  </Grid>
</Window>
