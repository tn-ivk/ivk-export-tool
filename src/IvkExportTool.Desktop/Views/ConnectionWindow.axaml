<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IvkExportTool.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="IvkExportTool.Desktop.Views.ConnectionWindow"
        x:DataType="vm:ConnectionWindowViewModel"
        Icon="/Assets/Transneft.ico"
        Title="IvkExportTool - Подключение к БД ИВК"
        Width="460" Height="360"
        MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True">

  <Design.DataContext>
    <vm:ConnectionWindowViewModel/>
  </Design.DataContext>

  <Grid>
    <!-- Основная карточка окна -->
    <Border CornerRadius="{StaticResource RadiusXLarge}"
            Background="{StaticResource BackgroundBrush}"
            BoxShadow="0 4 24 0 #40000000"
            Margin="16"
            ClipToBounds="True">

      <Grid RowDefinitions="Auto,*">

        <!-- Заголовок с кнопками (drag area) -->
        <Border Grid.Row="0"
                x:Name="TitleBar"
                Background="{StaticResource SurfaceVariantBrush}"
                CornerRadius="12,12,0,0"
                Padding="20,12">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0"
                       Text="Подключение к БД ИВК"
                       Classes="h4"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>

            <!-- Кнопка возврата -->
            <Button Grid.Column="1"
                    x:Name="BackButton"
                    Classes="window-back-button"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Margin="0,0,8,0"
                    Background="Transparent"
                    ToolTip.Tip="Вернуться к выбору способа подключения">
              <PathIcon Data="M11,9L12.41,10.41L8.83,14H18V20H20V12H8.83L12.41,8.41L11,7L5,13L11,19V9Z"
                        Width="16"
                        Height="16"/>
            </Button>

            <!-- Кнопка закрытия -->
            <Button Grid.Column="2"
                    x:Name="CloseButton"
                    Classes="window-close-button"
                    Width="28"
                    Height="28"
                    Padding="0"
                    ToolTip.Tip="Закрыть приложение">
              <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                        Width="14"
                        Height="14"/>
            </Button>
          </Grid>
        </Border>

        <!-- Контент формы -->
        <StackPanel Grid.Row="1"
                    Spacing="20"
                    Margin="24,20,24,24">

          <!-- Параметры подключения -->
          <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <!-- Host -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Хост:"
                       Classes="label"
                       VerticalAlignment="Center"
                       Margin="0,0,12,12"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding Host}"
                     Watermark="localhost или IP адрес"
                     Margin="0,0,0,12"/>

            <!-- Port -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Порт:"
                       Classes="label"
                       VerticalAlignment="Center"
                       Margin="0,0,12,12"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding Port}"
                     Watermark="3306"
                     Margin="0,0,0,12"/>

            <!-- Username -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="Логин:"
                       Classes="label"
                       VerticalAlignment="Center"
                       Margin="0,0,12,12"/>
            <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding Username}"
                     Watermark="root"
                     Margin="0,0,0,12"/>

            <!-- Password -->
            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="Пароль:"
                       Classes="label"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <TextBox Grid.Row="3" Grid.Column="1"
                     Text="{Binding Password}"
                     PasswordChar="●"
                     Watermark="password"/>
          </Grid>

          <!-- Кнопки -->
          <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
            <Button Grid.Column="0"
                    Classes="secondary"
                    Command="{Binding TestConnectionCommand}"
                    IsEnabled="{Binding !IsLoading}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,0,8,0"
                    Content="Тест подключения" />

            <Button Grid.Column="1"
                    Classes="primary"
                    Command="{Binding ConnectCommand}"
                    IsEnabled="{Binding !IsLoading}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="8,0,0,0"
                    Content="Подключиться" />
          </Grid>

        </StackPanel>
      </Grid>
    </Border>

    <!-- Слой для уведомлений -->
    <Panel x:Name="NotificationPanel" />
  </Grid>
</Window>
