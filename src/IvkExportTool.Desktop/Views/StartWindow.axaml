<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IvkExportTool.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="IvkExportTool.Desktop.Views.StartWindow"
        x:DataType="vm:StartWindowViewModel"
        Icon="/Assets/Transneft.ico"
        Title="IvkExportTool - Выбор способа подключения"
        Width="460" Height="360"
        MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True">

  <Design.DataContext>
    <vm:StartWindowViewModel/>
  </Design.DataContext>

  <Grid>
    <!-- Основная карточка окна -->
    <Border CornerRadius="{StaticResource RadiusXLarge}"
            Background="{StaticResource BackgroundBrush}"
            BoxShadow="0 4 24 0 #40000000"
            Margin="16"
            ClipToBounds="True">

      <Grid RowDefinitions="Auto,*">

        <!-- Заголовок с кнопкой закрытия (drag area) -->
        <Border Grid.Row="0"
                x:Name="TitleBar"
                Background="{StaticResource SurfaceVariantBrush}"
                CornerRadius="12,12,0,0"
                Padding="20,12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="Выбор способа подключения"
                       Classes="h4"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>

            <!-- Кнопка закрытия -->
            <Button Grid.Column="1"
                    x:Name="CloseButton"
                    Classes="window-close-button"
                    Width="28"
                    Height="28"
                    Padding="0"
                    ToolTip.Tip="Закрыть приложение">
              <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                        Width="14"
                        Height="14"/>
            </Button>
          </Grid>
        </Border>

        <!-- Контент с выбором -->
        <StackPanel Grid.Row="1"
                    Spacing="16"
                    Margin="24,32,24,24"
                    VerticalAlignment="Center">

          <!-- Кнопка ручной настройки -->
          <Button Classes="primary"
                  Command="{Binding ManualConnectionCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Height="80">
            <StackPanel Spacing="8">
              <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                        Width="24"
                        Height="24"/>
              <TextBlock Text="Ручная настройка подключения"
                         Classes="h5"/>
            </StackPanel>
          </Button>

          <!-- Кнопка автоподключения -->
          <Button Classes="secondary"
                  Command="{Binding AutoConnectionCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Height="80">
            <StackPanel Spacing="8">
              <PathIcon Data="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z"
                        Width="24"
                        Height="24"/>
              <TextBlock Text="Автоподключение"
                         Classes="h5"/>
            </StackPanel>
          </Button>

        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
