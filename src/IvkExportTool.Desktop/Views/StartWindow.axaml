<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IvkExportTool.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="IvkExportTool.Desktop.Views.StartWindow"
        x:DataType="vm:StartWindowViewModel"
        Icon="/Assets/Transneft.ico"
        Title="IvkExportTool - Выбор способа подключения"
        Width="460" Height="360"
        MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True">

  <Design.DataContext>
    <vm:StartWindowViewModel/>
  </Design.DataContext>

  <Grid>
    <!-- Основная карточка окна -->
    <Border CornerRadius="{StaticResource RadiusXLarge}"
            Background="{StaticResource BackgroundBrush}"
            BoxShadow="0 4 24 0 #40000000"
            Margin="16"
            ClipToBounds="True">

      <Grid RowDefinitions="Auto,*">

        <!-- Заголовок с кнопкой закрытия (drag area) -->
        <Border Grid.Row="0"
                x:Name="TitleBar"
                Background="{StaticResource SurfaceVariantBrush}"
                CornerRadius="12,12,0,0"
                Padding="20,12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="Выбор способа подключения"
                       Classes="h4"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>

            <!-- Кнопка закрытия -->
            <Button Grid.Column="1"
                    x:Name="CloseButton"
                    Classes="window-close-button"
                    Width="28"
                    Height="28"
                    Padding="0"
                    ToolTip.Tip="Закрыть приложение">
              <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                        Width="14"
                        Height="14"/>
            </Button>
          </Grid>
        </Border>

        <!-- Контент с выбором -->
        <StackPanel Grid.Row="1"
                    Spacing="16"
                    Margin="24,32,24,24"
                    VerticalAlignment="Center">

          <!-- Кнопка ручной настройки -->
          <Button Classes="primary"
                  Command="{Binding ManualConnectionCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Height="80">
            <StackPanel Spacing="20" Orientation="Horizontal">
              <PathIcon Data="M19.14,12.94C19.18,12.64 19.2,12.33 19.2,12C19.2,11.68 19.18,11.36 19.13,11.06L21.16,9.48C21.34,9.34 21.39,9.07 21.28,8.87L19.36,5.55C19.24,5.33 18.99,5.26 18.77,5.33L16.38,6.29C15.88,5.91 15.35,5.59 14.76,5.35L14.4,2.81C14.36,2.57 14.16,2.4 13.92,2.4H10.08C9.84,2.4 9.65,2.57 9.61,2.81L9.25,5.35C8.66,5.59 8.12,5.92 7.63,6.29L5.24,5.33C5.02,5.25 4.77,5.33 4.65,5.55L2.74,8.87C2.62,9.08 2.66,9.34 2.86,9.48L4.89,11.06C4.84,11.36 4.8,11.69 4.8,12C4.8,12.31 4.82,12.64 4.87,12.94L2.84,14.52C2.66,14.66 2.61,14.93 2.72,15.13L4.64,18.45C4.76,18.67 5.01,18.74 5.23,18.67L7.62,17.71C8.12,18.09 8.65,18.41 9.24,18.65L9.6,21.19C9.65,21.43 9.84,21.6 10.08,21.6H13.92C14.16,21.6 14.36,21.43 14.39,21.19L14.75,18.65C15.34,18.41 15.88,18.09 16.37,17.71L18.76,18.67C18.98,18.75 19.23,18.67 19.35,18.45L21.27,15.13C21.39,14.91 21.34,14.66 21.15,14.52L19.14,12.94M12,15.6C10.02,15.6 8.4,13.98 8.4,12C8.4,10.02 10.02,8.4 12,8.4C13.98,8.4 15.6,10.02 15.6,12C15.6,13.98 13.98,15.6 12,15.6Z"
                        Width="40"
                        Height="40"
                        VerticalAlignment="Center"/>
              <TextBlock Text="Ручная настройка подключения"
                         Classes="h5"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!-- Кнопка автоподключения -->
          <Button Classes="secondary"
                  Command="{Binding AutoConnectionCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Height="80">
            <StackPanel Spacing="20" Orientation="Horizontal">
              <PathIcon Data="M12,2A2,2 0 0,1 14,4C14,4.74 13.6,5.39 13,5.73V7H14A7,7 0 0,1 21,14H22A1,1 0 0,1 23,15V18A1,1 0 0,1 22,19H21V20A2,2 0 0,1 19,22H5A2,2 0 0,1 3,20V19H2A1,1 0 0,1 1,18V15A1,1 0 0,1 2,14H3A7,7 0 0,1 10,7H11V5.73C10.4,5.39 10,4.74 10,4A2,2 0 0,1 12,2M7.5,13A2.5,2.5 0 0,0 5,15.5A2.5,2.5 0 0,0 7.5,18A2.5,2.5 0 0,0 10,15.5A2.5,2.5 0 0,0 7.5,13M16.5,13A2.5,2.5 0 0,0 14,15.5A2.5,2.5 0 0,0 16.5,18A2.5,2.5 0 0,0 19,15.5A2.5,2.5 0 0,0 16.5,13Z"
                        Width="40"
                        Height="40"
                        VerticalAlignment="Center"/>
              <TextBlock Text="Автоподключение"
                         Classes="h5"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
